rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Starter rules: users can read/write only their own profile.
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    // No chat/message access until membership-based rules are implemented and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}